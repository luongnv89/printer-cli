/* prt — "lab instrument panel".
 * Black field, white type, gray hairlines, bright green as the only accent (focus, active, ok).
 * Ink is the only colour that fills anything. Red/amber appear on text only.
 * Gray (#6B7280, 4.3:1 on black) is used for borders and rules — never for text.
 */

Screen {
    background: #000000;
    color: #FFFFFF;
}

#topbar {
    height: 1;
    background: #000000;
    padding: 0 1;
}

TabbedContent {
    height: 1fr;
}

Tabs {
    background: #000000;
}

Tab {
    color: #FFFFFF;
    text-style: none;
}

Tab.-active {
    color: #22C55E;
    text-style: bold;
}

Tab:hover {
    color: #22C55E;
    background: #000000;
}

/* Textual paints the focused active tab with its blue cursor colour; keep it on-palette. */
Tabs:focus .-active, Tabs .-active, Tabs:focus Tab.-active {
    background: #000000;
    color: #22C55E;
    text-style: bold;
}

Underline > .underline--bar {
    background: #6B7280;
    color: #22C55E;
}

TabPane {
    padding: 1 1 0 1;
}

/* --- dashboard grid --------------------------------------------------------- */

#dash {
    layout: grid;
    grid-size: 2 2;
    grid-columns: 3fr 2fr;
    grid-rows: auto 1fr;
    grid-gutter: 1 2;
    height: 1fr;
}

#dash.narrow {
    grid-size: 1;
    grid-columns: 1fr;
    grid-rows: auto auto auto auto;
    overflow-y: auto;
}

Panel {
    border: round #6B7280;
    border-title-color: #FFFFFF;
    border-title-style: bold;
    padding: 0 1;
    height: auto;
    background: #000000;
}

Panel:focus {
    border: round #22C55E;
}

#ink {
    padding: 1 2 0 2;
    text-align: center;
}

#side {
    height: auto;
}

#side Panel {
    margin-bottom: 1;
}

/* --- actions ---------------------------------------------------------------- */

Button {
    background: #000000;
    color: #FFFFFF;
    border: round #6B7280;
    min-width: 18;
    height: 3;
    text-style: bold;
}

Button:hover {
    background: #000000;
    border: round #FFFFFF;
}

Button:focus {
    background: #000000;
    background-tint: #000000 0%;
    color: #22C55E;
    border: round #22C55E;
    text-style: bold;
}

Button.-active {
    background: #000000;
    border: round #22C55E;
}

Button.danger {
    color: #EF4444;
}

Button:disabled {
    color: #6B7280;
    border: round #6B7280;
    text-style: none;
}

.actions {
    height: auto;
    margin: 0 0 1 0;
}

.actions Button {
    margin-right: 2;
}

.hint {
    color: #FFFFFF;
    text-style: italic;
    margin: 0 0 1 0;
    height: auto;
}

.field-row {
    height: auto;
    margin-bottom: 1;
}

.field {
    width: 1fr;
    height: auto;
    margin-right: 2;
}

.field Label {
    margin-bottom: 0;
    text-style: bold;
}

Input, Select > SelectCurrent {
    background: #000000;
    color: #FFFFFF;
    border: round #6B7280;
}

Input:focus, Select:focus > SelectCurrent {
    border: round #22C55E;
}

Input > .input--placeholder {
    color: #FFFFFF;
    text-style: italic;
}

SelectOverlay {
    background: #000000;
    border: round #22C55E;
}

Switch {
    background: #000000;
    border: round #6B7280;
}

Switch:focus {
    border: round #22C55E;
}

Switch > .switch--slider {
    color: #6B7280;
    background: #000000;
}

Switch.-on > .switch--slider {
    color: #22C55E;
}

RichLog {
    background: #000000;
    border: round #6B7280;
    height: 1fr;
    min-height: 6;
    padding: 0 1;
}

RichLog:focus {
    border: round #22C55E;
}

DataTable {
    background: #000000;
    height: 1fr;
    border: round #6B7280;
}

DataTable:focus {
    border: round #22C55E;
}

DataTable > .datatable--header {
    background: #000000;
    color: #FFFFFF;
    text-style: bold;
}

/* Selected row: green text + underline — green stays a highlight, never a background. */
DataTable > .datatable--cursor {
    background: #000000;
    color: #22C55E;
    text-style: bold underline;
}

DataTable > .datatable--hover {
    background: #000000;
    text-style: underline;
}

/* --- modal ---------------------------------------------------------------------- */

ConfirmScreen {
    align: center middle;
    background: #000000 70%;
}

#dialog {
    width: 72;
    max-width: 95%;
    height: auto;
    border: round #22C55E;
    background: #000000;
    padding: 1 2;
}

#dialog #question {
    text-style: bold;
    margin-bottom: 1;
}

#dialog #details {
    margin-bottom: 1;
    height: auto;
}

#dialog .actions {
    align-horizontal: right;
    margin: 0;
}

Footer {
    background: #000000;
    color: #FFFFFF;
}

Footer .footer-key--key {
    background: #000000;
    color: #22C55E;
    text-style: bold;
}

Footer .footer-key--description {
    color: #FFFFFF;
}

Toast {
    background: #000000;
    border-left: outer #22C55E;
    color: #FFFFFF;
}

Toast.-error {
    border-left: outer #EF4444;
}

Toast.-warning {
    border-left: outer #F59E0B;
}
